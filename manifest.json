{
  "manifest_version": 3,
  "name": "Media Collector",
  "version": "0.12.3",
  "description": "Collect visual references from the web.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "adapters/instagram-network.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "author": "Maïssoum Aboudrare — imiximik"
}
